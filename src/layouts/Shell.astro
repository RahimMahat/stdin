---
import '../styles/theme.css'
import { profile } from '../data/profile'

interface Props {
  /** Browser title. The command itself, in most cases. */
  title: string
  description: string
  /** The input line shown after the prompt. Omit on the landing page. */
  command?: string
  /** Show the blinking cursor after the command (landing page only). */
  caret?: boolean
  /**
   * Whether to print the section row.
   *
   * Off on the landing page, whose own output is that same list of
   * destinations with a line of explanation under each — navigation should not
   * repeat what the page already is, and the grid is the better of the two.
   */
  crumbs?: boolean
  /**
   * An error line that is also the page's `<h1>`.
   *
   * Only /404 uses this. Every other page is headed by the command it echoes,
   * and a page reached by mistyping a URL has no command to echo — nothing was
   * typed, so printing a prompt with an error after it would be a lie about
   * what happened.
   */
  error?: string
  /** `noindex` on pages that are real files but should not be in the index. */
  robots?: string
  /**
   * Emit the Person node.
   *
   * On the three pages that are actually *about* him — the masthead, `whoami`
   * and the résumé — and nowhere else. `theme` is a real page and a fine one,
   * but a machine-readable claim that it is a biography of a person is noise,
   * and the node carries an `@id` so the three mentions resolve to one entity
   * rather than three.
   */
  person?: boolean
}

const {
  title,
  description,
  command,
  caret = false,
  crumbs = true,
  error,
  robots,
  person = false,
} = Astro.props
const full = title === 'stdin' ? 'rahim mahat — stdin' : `${title} — rahim mahat`

/**
 * The canonical URL.
 *
 * `build.format: 'file'` writes /help.html, so Astro.url.pathname carries the
 * extension at build time — but every href on the site points at /help, and the
 * host 308-redirects the .html form to it. A canonical naming a URL that
 * redirects is a canonical pointing at the wrong page, so the extension comes
 * off here and index collapses to the root.
 */
const canonical = new URL(Astro.url.pathname.replace(/(?:index)?\.html$/, '') || '/', Astro.site)

const origin = new URL('/', Astro.site)
const isRoot = canonical.pathname === '/'
const ogImage = new URL('/og.png', Astro.site)

/**
 * The entity.
 *
 * `sameAs` is the load-bearing field and the reason this block exists at all.
 * "Rahim Mahat" is not a rare string, and a search engine with no way to tell
 * this site apart from everyone else who shares the name will show the profile
 * it already trusts — which is LinkedIn. Naming the LinkedIn and GitHub
 * profiles here, from a page those profiles link back to, is what lets the
 * three be read as one person rather than three strangers.
 *
 * Nothing in here is new to the site: `contact` already prints the address and
 * both profile links as copyable text. This says the same thing in the form a
 * crawler can act on.
 */
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Person',
    '@id': `${origin}#rahim`,
    name: profile.name,
    url: origin.href,
    jobTitle: profile.role,
    description,
    email: `mailto:${profile.email}`,
    address: {
      '@type': 'PostalAddress',
      addressLocality: profile.location.split(',')[0].trim(),
      addressCountry: 'IN',
    },
    // profile.stack pairs tools for the prompt line ("Python + PySpark"), which
    // is a reading convenience, not a claim about one skill. Split it back out.
    knowsAbout: profile.stack.flatMap((s) => s.split('+').map((t) => t.trim())),
    sameAs: [profile.github, profile.linkedin],
  },
]

if (isRoot) {
  graph.push({
    '@type': 'WebSite',
    '@id': `${origin}#site`,
    url: origin.href,
    name: 'stdin',
    description,
    inLanguage: 'en',
    publisher: { '@id': `${origin}#rahim` },
  })
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />

    <!--
      og:url repeats the canonical on purpose: a share that arrives at /help.html
      should still be filed under /help, and the crawlers that read og: tags do
      not all read <link rel="canonical">.

      og:type is `profile` only where the page is actually about a person. On
      /help or /theme that claim would be false, and a false claim in machine
      -readable form is worse than a generic one.
    -->
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="stdin" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={person ? 'profile' : 'website'} />
    {
      person && (
        <>
          <meta property="profile:first_name" content={profile.name.split(' ')[0]} />
          <meta property="profile:last_name" content={profile.name.split(' ').slice(1).join(' ')} />
        </>
      )
    }

    <!--
      The card image. Generated by scripts/make-og.mjs, committed like the
      favicons, and the reason a link to this site posted anywhere renders as
      something rather than as a bare URL — which is the only lever the site
      itself has on whether anyone ever links to it.
    -->
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="A terminal prompt reading rahim@stdin ~ % whoami, above the name Rahim Mahat."
    />
    <meta name="twitter:card" content="summary_large_image" />

    {
      person && (
        <script type="application/ld+json" is:inline set:html={jsonLd} />
      )
    }

    <!--
      The mark is .caret — the amber block that blinks on the landing page.
      SVG first for anything modern; the .ico carries 16/32/48 for Windows tabs
      and pinned shortcuts. Both are generated by scripts/make-icons.mjs.
    -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Dark is the default regardless of the OS preference, so this is not
         media-queried; the scripts below move it when the theme actually changes. -->
    <meta name="theme-color" content="#14161d" />

    <!--
      Applied before first paint so the chosen theme never flashes. Dark is the
      default, so an unset preference needs no attribute at all.
      Phase 4 replaces the Google Fonts link with subset, self-hosted woff2.
    -->
    <script is:inline>
      ;(function () {
        try {
          var t = localStorage.getItem('stdin.theme')
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t)
            var m = document.querySelector('meta[name="theme-color"]')
            if (m) m.setAttribute('content', t === 'light' ? '#faf7f2' : '#14161d')
          }
        } catch (e) {
          /* private mode: fall through to the dark default */
        }
      })()
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,300..500&display=swap"
    />
  </head>

  <body>
    <a class="skip" href="/resume">skip to the plain résumé</a>

    <main class="session">
      <!--
        Absent on the landing page, whose own output is this same list of
        destinations with a line of explanation under each. Navigation should
        not repeat what the page already is.

        The argument halves are wrapped so the narrow breakpoint can drop them.
        `ls` and `git` are still the real command names, so the row shortens
        without saying anything untrue. "~" gets a spoken name because a screen
        reader otherwise announces it as "tilde", which is not a destination.
      -->
      {
        crumbs && (
          <nav class="crumbs" aria-label="sections">
            <a href="/" aria-label="home">~</a>
            <a href="/whoami">whoami</a>
            <a href="/ls">ls<span class="crumb-arg"> projects</span></a>
            <a href="/skills">skills</a>
            <a href="/git">git<span class="crumb-arg"> log</span></a>
            <a href="/now">now</a>
            <a href="/contact">contact</a>
          </nav>
        )
      }

      <!-- Landing page only: the one block that introduces rather than prints. -->
      <slot name="masthead" />

      <!--
        With a command it is the echo of what produced this page, and it stays.
        Without one it is scene-setting for visitors with no live prompt, and
        the shell hides it on mount — two prompts, one of them inert, reads as a
        broken input rather than as decoration.

        The echoed command is the page's <h1>. On this site the command *is* the
        page's identity — it is what the <title> says and the only thing on the
        page that names it — so the heading is text that was already there
        rather than a second title invented to satisfy a validator. Only the
        typed half: the PS1 stays a span, because a screen reader announcing
        "rahim at stdin tilde percent ls projects" as the heading is worse than
        having none. The landing page carries its own <h1> in the masthead and
        passes no command, so no page ever has two.
      -->
      <div class={command ? 'prompt-line' : 'prompt-line ghost'} aria-hidden={command ? undefined : 'true'}>
        <span class="ps1">rahim@stdin ~ %</span>
        {command && <h1 class="typed">{command}</h1>}
        {caret && <span class="caret"></span>}
      </div>

      <!--
        /404 only. It sits where the first line of output would sit and is
        styled as one, because that is what it is — the difference is that a
        page with no command to echo has nothing else that can carry its <h1>.
      -->
      {error && <h1 class="line o-fail">{error}</h1>}

      <div class="out" data-href={Astro.url.pathname}>
        <slot />
      </div>

      <!-- Output from commands run in this session is appended here. -->
      <div id="stream" class="stream"></div>

      <!--
        Ships hidden and disabled. The shell reveals it once it has loaded and
        has content to run against, so a visitor without JavaScript is never
        shown a prompt that cannot accept anything.
      -->
      <form id="tty" class="tty" hidden autocomplete="off">
        <label class="ps1" for="tty-in">rahim@stdin ~ %</label>
        <input
          id="tty-in"
          class="tty-in"
          type="text"
          name="cmd"
          disabled
          placeholder="loading…"
          role="combobox"
          aria-expanded="false"
          aria-controls="tty-ac"
          aria-autocomplete="list"
          aria-label="command"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
        />
        <ul id="tty-ac" class="ac" role="listbox" aria-label="completions" hidden></ul>
      </form>

      <p id="tty-status" class="sr-only" role="status" aria-live="polite"></p>

      <footer class="footer">
        <span>static build · no trackers</span>
        <a href="/help">help</a>
        <a href="/theme">theme</a>
        <a href="/resume">plain résumé</a>
      </footer>
    </main>

    <!--
      Phase 2. Everything above this line is a complete, readable page; this
      turns it into a session. Bundled and deferred, so it cannot delay paint,
      and every chip stays a working link if it never arrives.
    -->
    <script>
      import '../terminal/index.ts'
    </script>
  </body>
</html>
