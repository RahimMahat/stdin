---
import '../styles/theme.css'

interface Props {
  /** Browser title. The command itself, in most cases. */
  title: string
  description: string
  /** The input line shown after the prompt. Omit on the landing page. */
  command?: string
  /** Show the blinking cursor after the command (landing page only). */
  caret?: boolean
  /**
   * Whether to print the section row.
   *
   * Off on the landing page, whose own output is that same list of
   * destinations with a line of explanation under each — navigation should not
   * repeat what the page already is, and the grid is the better of the two.
   */
  crumbs?: boolean
}

const { title, description, command, caret = false, crumbs = true } = Astro.props
const full = title === 'stdin' ? 'rahim mahat — stdin' : `${title} — rahim mahat`

/**
 * The canonical URL.
 *
 * `build.format: 'file'` writes /help.html, so Astro.url.pathname carries the
 * extension at build time — but every href on the site points at /help, and the
 * host 308-redirects the .html form to it. A canonical naming a URL that
 * redirects is a canonical pointing at the wrong page, so the extension comes
 * off here and index collapses to the root.
 */
const canonical = new URL(Astro.url.pathname.replace(/(?:index)?\.html$/, '') || '/', Astro.site)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />

    <!--
      The mark is .caret — the amber block that blinks on the landing page.
      SVG first for anything modern; the .ico carries 16/32/48 for Windows tabs
      and pinned shortcuts. Both are generated by scripts/make-icons.mjs.
    -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Dark is the default regardless of the OS preference, so this is not
         media-queried; the scripts below move it when the theme actually changes. -->
    <meta name="theme-color" content="#14161d" />

    <!--
      Applied before first paint so the chosen theme never flashes. Dark is the
      default, so an unset preference needs no attribute at all.
      Phase 4 replaces the Google Fonts link with subset, self-hosted woff2.
    -->
    <script is:inline>
      ;(function () {
        try {
          var t = localStorage.getItem('stdin.theme')
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t)
            var m = document.querySelector('meta[name="theme-color"]')
            if (m) m.setAttribute('content', t === 'light' ? '#faf7f2' : '#14161d')
          }
        } catch (e) {
          /* private mode: fall through to the dark default */
        }
      })()
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,300..500&display=swap"
    />
  </head>

  <body>
    <a class="skip" href="/resume">skip to the plain résumé</a>

    <main class="session">
      <!--
        Absent on the landing page, whose own output is this same list of
        destinations with a line of explanation under each. Navigation should
        not repeat what the page already is.

        The argument halves are wrapped so the narrow breakpoint can drop them.
        `ls` and `git` are still the real command names, so the row shortens
        without saying anything untrue. "~" gets a spoken name because a screen
        reader otherwise announces it as "tilde", which is not a destination.
      -->
      {
        crumbs && (
          <nav class="crumbs" aria-label="sections">
            <a href="/" aria-label="home">~</a>
            <a href="/whoami">whoami</a>
            <a href="/ls">ls<span class="crumb-arg"> projects</span></a>
            <a href="/skills">skills</a>
            <a href="/git">git<span class="crumb-arg"> log</span></a>
            <a href="/now">now</a>
            <a href="/contact">contact</a>
          </nav>
        )
      }

      <!-- Landing page only: the one block that introduces rather than prints. -->
      <slot name="masthead" />

      <!--
        With a command it is the echo of what produced this page, and it stays.
        Without one it is scene-setting for visitors with no live prompt, and
        the shell hides it on mount — two prompts, one of them inert, reads as a
        broken input rather than as decoration.

        The echoed command is the page's <h1>. On this site the command *is* the
        page's identity — it is what the <title> says and the only thing on the
        page that names it — so the heading is text that was already there
        rather than a second title invented to satisfy a validator. Only the
        typed half: the PS1 stays a span, because a screen reader announcing
        "rahim at stdin tilde percent ls projects" as the heading is worse than
        having none. The landing page carries its own <h1> in the masthead and
        passes no command, so no page ever has two.
      -->
      <div class={command ? 'prompt-line' : 'prompt-line ghost'} aria-hidden={command ? undefined : 'true'}>
        <span class="ps1">rahim@stdin ~ %</span>
        {command && <h1 class="typed">{command}</h1>}
        {caret && <span class="caret"></span>}
      </div>

      <div class="out" data-href={Astro.url.pathname}>
        <slot />
      </div>

      <!-- Output from commands run in this session is appended here. -->
      <div id="stream" class="stream"></div>

      <!--
        Ships hidden and disabled. The shell reveals it once it has loaded and
        has content to run against, so a visitor without JavaScript is never
        shown a prompt that cannot accept anything.
      -->
      <form id="tty" class="tty" hidden autocomplete="off">
        <label class="ps1" for="tty-in">rahim@stdin ~ %</label>
        <input
          id="tty-in"
          class="tty-in"
          type="text"
          name="cmd"
          disabled
          placeholder="loading…"
          role="combobox"
          aria-expanded="false"
          aria-controls="tty-ac"
          aria-autocomplete="list"
          aria-label="command"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
        />
        <ul id="tty-ac" class="ac" role="listbox" aria-label="completions" hidden></ul>
      </form>

      <p id="tty-status" class="sr-only" role="status" aria-live="polite"></p>

      <footer class="footer">
        <span>static build · no trackers</span>
        <a href="/help">help</a>
        <a href="/theme">theme</a>
        <a href="/resume">plain résumé</a>
      </footer>
    </main>

    <!--
      Phase 2. Everything above this line is a complete, readable page; this
      turns it into a session. Bundled and deferred, so it cannot delay paint,
      and every chip stays a working link if it never arrives.
    -->
    <script>
      import '../terminal/index.ts'
    </script>
  </body>
</html>
