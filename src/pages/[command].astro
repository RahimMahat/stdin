---
import Shell from '../layouts/Shell.astro'
import { loadSite } from '../data/site'
import { canonical, pageCommands, runForPage } from '../commands'
import { renderStatic } from '../render/static'
import type { Command } from '../commands/types'

/**
 * Every command with a fixed output becomes a real page. This is the route that
 * makes the site indexable, shareable and usable with JavaScript off — the
 * terminal in phase 2 is an enhancement layered over these documents.
 */
export async function getStaticPaths() {
  const data = await loadSite()
  return pageCommands().map((cmd) => ({
    params: { command: cmd.name },
    props: { cmd, out: runForPage(cmd, data) },
  }))
}

const { cmd, out } = Astro.props as { cmd: Command; out: ReturnType<typeof runForPage> }
const html = renderStatic(out)
// Written as a sentence rather than scraped from the output. The output is a
// table or a record, and its first 155 characters made a snippet that read
// "start here production · one AWS platform at Infocepts independent · s…".
const { profile, projects } = await loadSite()
const description =
  cmd.name === 'ls'
    ? `${projects.length} data engineering projects by ${profile.name}, each with what it handled, what broke and what changed.`
    : `${profile.name}, ${profile.role}: ${cmd.summary}.`
---

<Shell
  title={cmd.name}
  description={description}
  command={canonical(cmd)}
  person={cmd.name === 'whoami'}
>
  <Fragment set:html={html} />
</Shell>
